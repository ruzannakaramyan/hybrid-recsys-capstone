 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 📊 Enriched Dataset EDA & Visualizations\n",
    "\n",
    "This notebook provides a visual breakdown of the three datasets in the Hybrid Recommender project:\n",
    "1. **Industrial & Scientific**\n",
    "2. **Video Games**\n",
    "3. **Cell Phones & Accessories**\n",
    "\n",
    "We focus on **Ratings Class Balance**, **User Interaction History Density**, and **Semantic Vocabulary**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import os\n",
    "import numpy as np\n",
    "from wordcloud import WordCloud\n",
    "import random\n",
    "\n",
    "# Set visual style\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (12, 6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_and_prep(file_path, name):\n",
    "    if not os.path.exists(file_path):\n",
        "        # Try root relative path if needed\n",
        "        root_path = os.path.join(\"..\", file_path) if not file_path.startswith(\"..\") else file_path\n",
        "        if not os.path.exists(root_path):\n",
    "            print(f\"File not found: {file_path}\")\n",
    "            return None\n",
        "        file_path = root_path\n",
    "    \n",
    "    print(f\"Loading {name}...\")\n",
    "    df = pd.read_csv(file_path, usecols=['rating', 'history', 'title'])\n",
    "    df['seq_len'] = df['history'].apply(lambda x: len(str(x).split()) if pd.notnull(x) else 0)\n",
    "    return df\n",
    "\n",
    "datasets_paths = {\n",
    "    \"Industrial & Scientific\": \"../data/train_industrial_and_scientific_merged.csv\",\n",
    "    \"Video Games\": \"../data/train_video_games_merged.csv\",\n",
    "    \"Cell Phones\": \"../data/train_cell_phones_and_accessories_merged.csv\"\n",
    "}\n",
    "\n",
    "data_frames = {}\n",
    "for name, path in datasets_paths.items():\n",
    "    df = load_and_prep(path, name)\n",
    "    if df is not None:\n",
    "        data_frames[name] = df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Ratings Class Balance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if data_frames:\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n",
    "    for i, (name, df) in enumerate(data_frames.items()):\n",
    "        counts = df['rating'].value_counts().sort_index()\n",
    "        sns.barplot(x=counts.index, y=counts.values, ax=axes[i], palette=\"viridis\", hue=counts.index, legend=False)\n",
    "        axes[i].set_title(f\"Ratings: {name}\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Interaction History Density"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if data_frames:\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n",
    "    for i, (name, df) in enumerate(data_frames.items()):\n",
    "        threshold = df['seq_len'].quantile(0.95)\n",
    "        sns.histplot(df[df['seq_len'] <= threshold]['seq_len'], bins=20, ax=axes[i], kde=True, color=\"teal\")\n",
    "        axes[i].set_title(f\"Seq Lengths: {name} (Top 95%)\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Semantic Domain Analysis (Word Clouds)\n",
    "\n",
    "Generated using the brand palette: Deep Blue (#230871), Coral (#f4592f), and Yellow (#f8c000)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def brand_color_func(word, font_size, position, orientation, random_state=None, **kwargs):\n",
    "    return random.choice([\"#230871\", \"#f4592f\", \"#f8c000\"])\n",
    "\n",
    "if data_frames:\n",
    "    for name, df in data_frames.items():\n",
    "        print(f\"Generating WordCloud for {name}...\")\n",
    "        text = \" \".join(df['title'].astype(str).tolist())\n",
    "        wc = WordCloud(width=1200, height=600, background_color='white', max_words=100, \n",
    "                       color_func=brand_color_func, prefer_horizontal=0.7).generate(text)\n",
    "        \n",
    "        plt.figure(figsize=(15, 8))\n",
    "        plt.imshow(wc, interpolation='bilinear')\n",
    "        plt.axis(\"off\")\n",
    "        plt.title(f\"Domain Vocabulary: {name}\", fontsize=20, fontweight='bold', color='#230871')\n",
    "        plt.show()"
   ]
  }\n",
 ],
